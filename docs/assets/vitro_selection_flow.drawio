        <mxCell id="title" value="ระบบการคัดเลือก — การจัดกลุ่มความพร้อม (Verdict / Selection Flow)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="800" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Rule-based + คุณภาพภาพ (interpretable) · 3 กลุ่ม: พร้อมอนุบาล / ยังไม่พร้อม / ตรวจเอง" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="900" height="24" as="geometry"/>
        </mxCell>

        <!-- Input -->
        <mxCell id="in" value="INPUT — ภาพขวด + feature ที่คำนวณจาก mask\n(coverage · height_proxy · width · leaf/shoot/root count · สี · glare · condensation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="900" height="60" as="geometry"/>
        </mxCell>

        <!-- Gate 1: quality -->
        <mxCell id="g1" value="เกตคุณภาพภาพ (Quality Gate) — ภาพชัดไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="230" width="480" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="g1cond" value="glare_score &gt; 40  หรือ  condensation_score &gt; 40  หรือ  ไม่พบขวด (ROI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="325" width="580" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="g1yes" value="ใช่ (ภาพไม่ชัด)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#E65100;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="130" height="30" as="geometry"/>
